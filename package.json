{
  "name": "bp-plant-war",
  "version": "3.2.9",
  "description": "植物大战僵尸BP对战辅助工具",
  "type": "module",
  "scripts": {
    "dev": "node server/dev-all.mjs",
    "dev:web": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "node scripts/setup-hooks.mjs",
    "test": "playwright test",
    "test:agents": "node agents/test-coordinator.js --suite all",
    "test:quick": "node agents/test-coordinator.js --suite game-init",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:multiplayer": "playwright test agents/tests/multiplayer-sync-test.spec.js",
    "test:multiplayer:headed": "playwright test agents/tests/multiplayer-sync-test.spec.js --headed",
    "test:unit": "vitest",
    "test:unit:run": "vitest run"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.3",
    "@playwright/test": "^1.40.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.5",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.0",
    "vite-plugin-vue-devtools": "^7.7.10",
    "vitest": "^1.6.0"
  }
}
